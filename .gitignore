# Python caches and virtual environments
__pycache__/
*.py[codz]
*$py.class
.venv/
venv/
env/
ENV/

# Build and package output
build/
dist/
target/
*.egg-info/
*.bin
*.elf
*.hex
*.uf2
*.dfu
*.map
*.mpy
*.o
*.a
*.so

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.tox/
.nox/

# Local configuration and secrets
.env
.env.*
!.env.example
.envrc
.pypirc
.streamlit/secrets.toml
secrets/
**/secrets/
*.secret
*.pem
*.key
*.p12
*.pfx
*.keystore

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Keep the firmware build instructions tracked; ignore generated build contents.
!firmware/build/
firmware/build/*
!firmware/build/README.md
